<!DOCTYPE html>

<html>

<head>

    <title>Your Cart | StyleCart</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<header>

    <div class="logo">
        STYLECART
    </div>

    <nav>

        <a href="/">Home</a>
        <a href="/cart">Cart 🛒</a>

    </nav>

</header>


<div class="cart-container">

    <h1>Your Shopping Cart</h1>

    <div class="cart-layout">


        <div class="cart-items">

            <% products.slice(0, 2).forEach(product => { %>

                <div class="cart-item">

                    <img
                        src="<%= product.image %>"
                    >

                    <div>

                        <h3>
                            <%= product.name %>
                        </h3>

                        <p>
                            ₹<%= product.price %>
                        </p>

                        <p>
                            Quantity: 1
                        </p>

                    </div>

                </div>

            <% }) %>

        </div>


        <div class="summary">

            <h2>Order Summary</h2>

            <div>
                <span>Subtotal</span>
                <span>₹2698</span>
            </div>

            <div>
                <span>Delivery</span>
                <span>FREE</span>
            </div>

            <hr>

            <div class="total">

                <span>Total</span>

                <strong>
                    ₹2698
                </strong>

            </div>

            <a
                href="/checkout?productId=1"
                class="buy-btn"
            >
                Proceed to Checkout
            </a>

        </div>

    </div>

</div>

</body>

</html>